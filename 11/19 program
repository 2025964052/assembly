org 100h

jmp start

; --- 데이터 영역 ---
msg1        db 0Dh, 0Ah, '첫 번째 숫자 (0-9): $'
msg2        db 0Dh, 0Ah, '두 번째 숫자 (0-9): $'
msg_add     db 0Dh, 0Ah, '덧셈 (AX + BX): $'
msg_sub     db 0Dh, 0Ah, '뺄셈 (AX - BX): $'
msg_mul     db 0Dh, 0Ah, '곱셈 (AX * BX): $'
msg_div     db 0Dh, 0Ah, '나눗셈 몫 (AX / BX): $'
msg_rem     db ', 나머지: $'
msg_div_err db 0Dh, 0Ah, '나눗셈 오류: 0으로 나눌 수 없습니다.$'
msg_regs    db 0Dh, 0Ah, 0Dh, 0Ah, '--- 레지스터 상태 (HEX) ---$'
lbl_ax      db 0Dh, 0Ah, 'AX = $'
lbl_bx      db 0Dh, 0Ah, 'BX = $'
lbl_cx      db 0Dh, 0Ah, 'CX = $'
lbl_dx      db 0Dh, 0Ah, 'DX = $'

num1        dw 0
num2        dw 0

; --- 코드 영역 ---
start:
    ; 1. 첫 번째 숫자 입력
    lea dx, msg1
    mov ah, 09h
    int 21h

    mov ah, 01h         ; 키보드 문자 입력 (AL에 ASCII 코드 저장)
    int 21h
    sub al, '0'         ; ASCII -> 정수 변환
    xor ah, ah
    mov num1, ax

    ; 2. 두 번째 숫자 입력
    lea dx, msg2
    mov ah, 09h
    int 21h

    mov ah, 01h
    int 21h
    sub al, '0'
    xor ah, ah
    mov num2, ax

    ; --- 덧셈 ---
    mov ax, num1
    mov bx, num2
    add ax, bx          ; AX = num1 + num2
    push ax             ; 결과 임시 저장

    lea dx, msg_add
    mov ah, 09h
    int 21h
    pop ax
    push ax
    call print_dec_u16
    pop ax
    call print_registers

    ; --- 뺄셈 ---
    mov ax, num1
    mov bx, num2
    sub ax, bx          ; AX = num1 - num2 (부호 있는 16비트)
    push ax

    lea dx, msg_sub
    mov ah, 09h
    int 21h
    pop ax
    push ax
    call print_dec_s16
    pop ax
    call print_registers

    ; --- 곱셈 ---
    mov ax, num1
    mov bx, num2
    mul bx              ; DX:AX = AX * BX (한 자리 곱셈이므로 AX에 결과)
    push ax

    lea dx, msg_mul
    mov ah, 09h
    int 21h
    pop ax
    push ax
    call print_dec_u16
    pop ax
    call print_registers

    ; --- 나눗셈 ---
    mov ax, num1
    mov bx, num2
    cmp bx, 0
    je div_by_zero

    xor dx, dx          ; 상위 워드 DX 초기화 (DX:AX / BX)
    div bx              ; 몫 -> AX, 나머지 -> DX
    push dx             ; 나머지 저장
    push ax             ; 몫 저장

    lea dx, msg_div
    mov ah, 09h
    int 21h
    pop ax
    call print_dec_u16

    lea dx, msg_rem
    mov ah, 09h
    int 21h
    pop ax              ; 저장해 둔 나머지를 AX로 가져와 출력
    call print_dec_u16

    mov ax, num1
    mov bx, num2
    xor dx, dx
    div bx              ; 레지스터 상태 확인을 위해 동일 연산 후 출력
    call print_registers
    jmp done

div_by_zero:
    lea dx, msg_div_err
    mov ah, 09h
    int 21h
    mov ax, num1
    mov bx, num2
    call print_registers

done:
    mov ah, 4Ch         ; 프로그램 종료
    int 21h

; ==========================================
; 서브루틴: AX, BX, CX, DX를 16진수(4자리)로 출력
; (호출 당시의 AX, BX, CX, DX 값을 보존하며 출력)
; ==========================================
print_registers:
    push ax
    push bx
    push cx
    push dx

    ; 스택에서 원래 값 읽기:
    ; [bp+6]=원래AX, [bp+4]=원래BX, [bp+2]=원래CX, [bp+0]=원래DX
    mov bp, sp

    lea dx, msg_regs
    mov ah, 09h
    int 21h

    ; AX 출력
    lea dx, lbl_ax
    mov ah, 09h
    int 21h
    mov ax, [bp+6]
    call print_hex16

    ; BX 출력
    lea dx, lbl_bx
    mov ah, 09h
    int 21h
    mov ax, [bp+4]
    call print_hex16

    ; CX 출력
    lea dx, lbl_cx
    mov ah, 09h
    int 21h
    mov ax, [bp+2]
    call print_hex16

    ; DX 출력
    lea dx, lbl_dx
    mov ah, 09h
    int 21h
    mov ax, [bp+0]
    call print_hex16

    pop dx
    pop cx
    pop bx
    pop ax
    ret

; ==========================================
; 서브루틴: AX의 16비트 값을 4자리 HEX로 출력
; ==========================================
print_hex16:
    push ax
    push bx
    push cx
    push dx

    mov bx, ax
    mov cx, 4           ; 4니블(16비트)

hex_loop:
    rol bx, 4           ; 최상위 4비트를 최하위로 회전
    mov dl, bl
    and dl, 0Fh
    cmp dl, 9
    jbe is_digit
    add dl, 'A' - 10
    jmp print_hex_char
is_digit:
    add dl, '0'
print_hex_char:
    mov ah, 02h
    int 21h
    loop hex_loop

    pop dx
    pop cx
    pop bx
    pop ax
    ret

; ==========================================
; 서브루틴: AX의 부호 없는 10진수 출력
; ==========================================
print_dec_u16:
    push ax
    push bx
    push cx
    push dx

    mov cx, 0
    mov bx, 10
    cmp ax, 0
    jne u16_div_loop
    mov dl, '0'
    mov ah, 02h
    int 21h
    jmp u16_done

u16_div_loop:
    cmp ax, 0
    je u16_print_loop
    xor dx, dx
    div bx
    push dx
    inc cx
    jmp u16_div_loop

u16_print_loop:
    cmp cx, 0
    je u16_done
    pop dx
    add dl, '0'
    mov ah, 02h
    int 21h
    dec cx
    jmp u16_print_loop

u16_done:
    pop dx
    pop cx
    pop bx
    pop ax
    ret

; ==========================================
; 서브루틴: AX의 부호 있는 10진수 출력 (뺄셈 음수 처리)
; ==========================================
print_dec_s16:
    push ax
    push dx

    test ax, 8000h      ; 최상위 비트 확인 (음수 여부)
    jz s16_pos
    push ax
    mov dl, '-'
    mov ah, 02h
    int 21h
    pop ax
    neg ax              ; 2의 보수로 절댓값 변환

s16_pos:
    call print_dec_u16

    pop dx
    pop ax
    ret
